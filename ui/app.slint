import { CheckBox, LineEdit, ListView, Palette, ComboBox, ScrollView, SpinBox } from "std-widgets.slint";

export struct FileRow {
    path: string,
    hash: string,
    short-hash: string,
    size: string,
    added: string,
    present: bool,
    remotes: string,
    other-names: string,
    past-names: string,
    versions: string,
    selected: bool,
    // Copies known (local + remotes), and whether that is below the
    // folder's minimum.
    copies: int,
    at-risk: bool,
}

export struct RemoteRow {
    name: string,
    // How it stores: "encrypted", "NOT encrypted", or an old-style target.
    storage: string,
    blobs: string,
    // Blobs recorded on this remote that are not present locally.
    missing-locally: int,
}

// A remote as a metadata backup destination.
export struct MetadataRow {
    name: string,
    storage: string,
    // Chosen to receive metadata backups.
    enabled: bool,
    // "up to date · …", "out of date · …", "never backed up".
    status: string,
    up-to-date: bool,
}

// One input of the per-backend setup form.
export struct FormField {
    key: string,
    label: string,
    // Where the field is documented: a URL, or a page of mbr's docs.
    docs: string,
    kind: int,          // 0 = text, 1 = secret, 2 = choice
    default: string,    // placeholder shown while the input is empty
    default-index: int, // preselected example for kind == 2
    examples: [string], // values for kind == 2
    labels: [string],   // how each example is shown
    required: bool,
}

// Wrapped text only reserves the right height when its width is known
// up front, so sidebar text is sized from the panel width explicitly.
global Side {
    in-out property <length> width: 460px;
    // Width available to text inside the panel's padding.
    out property <length> text-width: self.width - 28px;
}

component Hint inherits Text {
    font-size: 11px;
    wrap: word-wrap;
    color: Palette.foreground.transparentize(40%);
    width: Side.text-width;
}

// Opens documentation in the browser: a URL, or a page of mbr's docs
// site such as "remotes/#scanning".
export global Docs {
    callback open(page: string);
}

// A small "?" that opens the docs for whatever it sits next to. It takes
// the full height of its row and centers the dot in it.
component Help {
    in property <string> page;
    width: 16px;
    min-height: 16px;
    accessible-role: button;
    accessible-label: "Help";
    accessible-action-default => { Docs.open(root.page); }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 16px;
        border-radius: self.height / 2;
        background: touch.has-hover ? Palette.accent-background : Palette.foreground.transparentize(82%);

        Text {
            text: "?";
            font-size: 10px;
            font-weight: 700;
            color: touch.has-hover ? Palette.accent-foreground : Palette.foreground.transparentize(30%);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Docs.open(root.page); }
        }
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    // Docs page for the "?" next to the title; none when empty.
    in property <string> help;
    spacing: 6px;
    alignment: start;
    Text {
        text: root.text;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        color: Palette.foreground.transparentize(35%);
    }
    if root.help != "": Help { page: root.help; }
}

component DetailLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Palette.foreground.transparentize(40%);
        width: 60px;
    }
    Text {
        text: root.value;
        font-size: 12px;
        wrap: word-wrap;
        width: Side.text-width - 66px;
    }
}

// The std-widgets Button can't change the mouse cursor (its own touch
// area always resets it), so buttons are drawn here, Fluent-like.
component Button {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    private property <brush> text-color: !root.enabled ? Palette.foreground.transparentize(55%)
        : root.primary ? Palette.accent-foreground : Palette.control-foreground;

    min-width: max(32px, label.preferred-width + 24px);
    min-height: max(32px, label.preferred-height + 10px);
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { touch.clicked(); }

    background := Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: root.primary ? transparent : Palette.border;
        background: root.primary
            ? (!root.enabled ? Palette.accent-background.transparentize(60%)
                : touch.pressed ? Palette.accent-background.darker(0.15)
                : touch.has-hover ? Palette.accent-background.brighter(0.1)
                : Palette.accent-background)
            : (!root.enabled ? Palette.control-background.transparentize(50%)
                : touch.pressed ? Palette.control-background.darker(0.1)
                : touch.has-hover ? Palette.control-background.darker(0.05)
                : Palette.control-background);
        animate background { duration: 150ms; }
    }

    label := Text {
        text: root.text;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        x: 0;
        width: 0; // Do not react on clicks
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus && root.enabled: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Palette.accent-background;
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    min-width: label.preferred-width + 24px;
    border-radius: 6px;
    background: root.active ? Palette.accent-background
        : touch.has-hover ? Palette.background.darker(0.08) : transparent;

    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Palette.accent-foreground : Palette.foreground;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The labelled inputs of a backend form, writing answers into `values`.
component BackendForm inherits VerticalLayout {
    in property <[FormField]> fields;
    in-out property <[string]> values;
    in property <bool> enabled: true;
    spacing: 8px;

    for field[i] in root.fields: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: field.required ? field.label + " *" : field.label;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if field.required: Text {
                text: "required";
                font-size: 9px;
                color: #e0a94f;
                vertical-alignment: center;
            }
            if field.docs != "": Help { page: field.docs; }
        }
        if field.kind == 2: ComboBox {
            // Reports a far too tall preferred height in sidebar layouts.
            max-height: self.min-height;
            model: field.labels;
            current-index: field.default-index;
            enabled: root.enabled;
            selected => { root.values[i] = field.examples[self.current-index]; }
        }
        if field.kind != 2: LineEdit {
            text: root.values[i];
            enabled: root.enabled;
            placeholder-text: field.default;
            edited(t) => { root.values[i] = t; }
        }
    }
}

// Pick a remote and merge the metadata backup it holds into the folder.
component RestoreForm inherits VerticalLayout {
    in property <[string]> remote-names;
    in property <bool> busy;
    // The folder is unlocked: an empty password means that one.
    in property <bool> unlocked;
    in-out property <int> remote-index;
    in-out property <string> password;
    callback restore(remote: string, password: string);

    spacing: 6px;
    if root.remote-names.length == 0: Hint {
        text: "No remotes configured yet.";
    }
    if root.remote-names.length > 0: VerticalLayout {
        spacing: 6px;
        ComboBox {
            // Reports a far too tall preferred height in sidebar layouts.
            max-height: self.min-height;
            model: root.remote-names;
            current-index <=> root.remote-index;
        }
        LineEdit {
            input-type: InputType.password;
            placeholder-text: root.unlocked
                ? "the backup's master password, if different"
                : "the backup's master password";
            text <=> root.password;
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: "Restore";
                enabled: !root.busy && (root.password != "" || root.unlocked);
                clicked => {
                    root.restore(
                        root.remote-names[clamp(root.remote-index, 0, root.remote-names.length - 1)],
                        root.password);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "My Beloved Rubble";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 480px;

    // ── State ──
    in-out property <string> folder: "";
    in-out property <[FileRow]> files: [];
    in-out property <[RemoteRow]> remotes: [];
    in-out property <[string]> remote-names: [];
    in-out property <string> status-text: "Open a folder to get started";
    in-out property <bool> busy: false;
    // 0 = Blobs, 1 = Remotes, 2 = Settings.
    in-out property <int> active-tab: 0;
    // Copies of every file to keep (local + remotes).
    in-out property <int> min-copies: 2;
    // Files with fewer copies than that.
    in-out property <int> at-risk-count: 0;
    // Local copies of old versions and deleted files, e.g. "3 (1.2 MiB)".
    in-out property <int> old-local-count: 0;
    in-out property <string> old-local-size: "";

    // ── settings: master password, metadata backup ──
    in-out property <[MetadataRow]> metadata-rows: [];
    in-out property <int> metadata-chosen: 0;
    in-out property <string> metadata-summary: "";
    in-out property <bool> password-set: false;
    // The master password is known (saved on this computer).
    in-out property <bool> unlocked: false;
    // Some remote is encrypted with the master password, so it can't change.
    in-out property <bool> has-encrypted-remotes: false;
    // The folder tracks nothing yet: restoring a backup comes first.
    in-out property <bool> folder-empty: false;
    in-out property <string> pw-new: "";
    in-out property <string> pw-repeat: "";
    in-out property <string> pw-entry: "";
    in-out property <string> pw-restore: "";
    in-out property <int> restore-remote-index: 0;
    // Side panel width; drag the divider to change it.
    in-out property <length> sidebar-width <=> Side.width;

    // ── blob selection (kept by the Rust side) ──
    in-out property <int> selected-count: 0;
    // The one selected row, when exactly one is selected; else -1.
    in-out property <int> detail-index: -1;
    in-out property <string> selection-summary: "";
    // Distinct selected blobs present / missing locally.
    in-out property <int> selection-local: 0;
    in-out property <int> selection-missing: 0;

    // Name for the guided remote setup.
    in-out property <string> new-remote-name: "";
    // Set up the new remote without encryption.
    in-out property <bool> new-remote-plain: false;

    // ── guided remote setup ──
    in-out property <[string]> backend-titles: [];
    in-out property <string> setup-backend: "";
    in-out property <bool> setup-active: false;
    in-out property <[FormField]> form-fields: [];
    in-out property <[string]> form-values: [];
    // rclone question fallback (OAuth etc.)
    in-out property <string> setup-state: "";
    in-out property <string> setup-question: "";
    in-out property <string> setup-help: "";
    in-out property <string> setup-answer: "";
    in-out property <string> setup-default: "";
    in-out property <string> setup-url: "";

    // ── editing an existing remote ──
    in-out property <bool> editing: false;
    in-out property <string> edit-original: "";
    in-out property <string> edit-name: "";
    // How it stores: "encrypted", "NOT encrypted", …
    in-out property <string> edit-description: "";
    in-out property <string> edit-note: "";
    in-out property <[FormField]> edit-fields: [];
    in-out property <[string]> edit-values: [];

    // The remote picked for actions on the selected blobs.
    in-out property <int> action-remote-index: 0;
    property <string> action-remote: root.remote-names[clamp(root.action-remote-index, 0, max(0, root.remote-names.length - 1))];

    property <length> row-height: 40px;
    property <bool> has-detail: root.detail-index >= 0 && root.detail-index < root.files.length;

    // ── Callbacks ──
    callback open-folder();
    callback rescan();
    // blob selection: `toggle` is Ctrl/Cmd, `extend` is Shift
    callback row-pressed(index: int, toggle: bool, extend: bool);
    callback row-dragged(index: int);
    callback select-all();
    callback clear-selection();
    // actions on the selected blobs
    callback upload-selected(remote: string);
    callback check-selected(remote: string);
    callback download-selected(remote: string);
    // remote management
    callback scan-remote(name: string);
    callback scan-all-remotes();
    callback download-all(name: string);
    callback push-all(remote: string);
    callback edit-remote(name: string);
    callback save-remote-edit();
    callback cancel-remote-edit();
    callback remove-remote(name: string);
    callback select-backend(name: string);
    callback submit-form(name: string, backend: string, values: [string], plain: bool);
    callback submit-remote-setup(backend: string, state: string, answer: string);
    callback cancel-remote-setup();
    // keeping copies safe
    callback drop-selected();
    callback verify-selected();
    callback verify-selected-on(remote: string);
    callback verify-all-local();
    callback clean-up-old();
    callback set-min-copies(n: int);
    // metadata backup
    callback toggle-metadata-remote(name: string, enabled: bool);
    callback set-password(password: string, repeat: string);
    callback unlock(password: string);
    callback backup-metadata();
    callback restore-metadata(remote: string, password: string);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ══ Toolbar ══
        Rectangle {
            height: 52px;
            background: Palette.background.darker(0.06);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;

                Text {
                    text: "My Beloved Rubble";
                    font-weight: 700;
                    font-size: 16px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 8px;
                    TabButton {
                        text: "Blobs (" + root.files.length + ")";
                        active: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }
                    TabButton {
                        text: "Remotes (" + root.remotes.length + ")";
                        active: root.active-tab == 1;
                        clicked => { root.active-tab = 1; }
                    }
                    TabButton {
                        text: "Settings";
                        active: root.active-tab == 2;
                        clicked => { root.active-tab = 2; }
                    }
                }
                Text {
                    text: root.folder;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(40%);
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Open Folder…";
                    clicked => { root.open-folder(); }
                }
                Button {
                    text: "Rescan";
                    enabled: root.folder != "" && !root.busy;
                    clicked => { root.rescan(); }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // ══ Content ══
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 0px;
            spacing: 0px;

            // ── Main area ──
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.background;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    if root.folder == "": Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Text {
                                text: "No folder attached";
                                font-size: 18px;
                                horizontal-alignment: center;
                                color: Palette.foreground.transparentize(40%);
                            }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Button {
                                    text: "Open Folder…";
                                    primary: true;
                                    clicked => { root.open-folder(); }
                                }
                                Help { page: "getting-started/"; }
                            }
                        }
                    }

                    // ── Blobs tab: the file list ──
                    if root.folder != "" && root.active-tab == 0 && root.files.length == 0: Rectangle {
                        vertical-stretch: 1;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "No tracked files yet.";
                                font-size: 14px;
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(40%);
                            }
                            Help { page: "getting-started/#adding-files"; }
                        }
                    }

                    if root.folder != "" && root.active-tab == 0 && root.files.length > 0: list-keys := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if ((event.modifiers.control || event.modifiers.meta)
                                && (event.text == "a" || event.text == "A")) {
                                root.select-all();
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.clear-selection();
                                return accept;
                            }
                            reject
                        }

                        ListView {
                            for file[idx] in root.files: Rectangle {
                                height: root.row-height;
                                background: file.selected
                                    ? Palette.accent-background
                                    : row-touch.has-hover ? Palette.background.darker(0.04) : transparent;
                                border-radius: 6px;

                                row-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down
                                            && event.button == PointerEventButton.left) {
                                            list-keys.focus();
                                            root.row-pressed(
                                                idx,
                                                event.modifiers.control || event.modifiers.meta,
                                                event.modifiers.shift);
                                        }
                                    }
                                    // Dragging across rows selects them.
                                    moved => {
                                        if (self.pressed) {
                                            root.row-dragged(idx + floor(self.mouse-y / root.row-height));
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    // local presence dot
                                    Text {
                                        text: file.present ? "●" : "○";
                                        color: file.present
                                            ? #2fbf71
                                            : #e05f5f;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        width: 14px;
                                    }
                                    Text {
                                        text: file.path;
                                        font-size: 13px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: file.selected
                                            ? Palette.accent-foreground : Palette.foreground;
                                    }
                                    Text {
                                        text: file.size;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        color: file.selected
                                            ? Palette.accent-foreground.transparentize(20%)
                                            : Palette.foreground.transparentize(35%);
                                    }
                                    Text {
                                        text: file.remotes == "" ? (file.present ? "only here" : "nowhere") : file.remotes;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        width: 140px;
                                        overflow: elide;
                                        color: file.at-risk
                                            ? #e05f5f
                                            : file.selected
                                                ? Palette.accent-foreground.transparentize(20%)
                                                : Palette.foreground.transparentize(35%);
                                    }
                                    Text {
                                        text: file.short-hash;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        color: file.selected
                                            ? Palette.accent-foreground.transparentize(30%)
                                            : Palette.foreground.transparentize(50%);
                                    }
                                }
                            }
                        }
                    }

                    // ── Remotes tab: the remote list ──
                    if root.folder != "" && root.active-tab == 1: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Keep";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        SpinBox {
                            max-height: self.min-height;
                            width: 96px;
                            minimum: 1;
                            maximum: 9;
                            value: root.min-copies;
                            enabled: !root.busy;
                            edited(n) => { root.set-min-copies(n); }
                        }
                        Text {
                            text: "copies of every file";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Help { page: "remotes/#how-many-copies"; }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.folder != "" && root.active-tab == 1: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.remotes.length == 0 ? "No remotes configured yet." : "";
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            color: Palette.foreground.transparentize(40%);
                        }
                        Help { page: "remotes/#scanning"; }
                        Button {
                            text: "Scan all";
                            enabled: !root.busy && root.remotes.length > 0;
                            clicked => { root.scan-all-remotes(); }
                        }
                    }

                    if root.folder != "" && root.active-tab == 1: ListView {
                        vertical-stretch: 1;
                        for remote in root.remotes: VerticalLayout {
                            padding-bottom: 8px;
                            Rectangle {
                                border-width: 1px;
                                border-color: root.editing && root.edit-original == remote.name
                                    ? Palette.accent-background : Palette.border;
                                border-radius: 6px;
                                background: Palette.background.darker(0.02);
                                height: remote-layout.preferred-height;

                                remote-layout := VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: remote.name;
                                            font-weight: 700;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: remote.blobs;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            color: Palette.foreground.transparentize(40%);
                                        }
                                        if remote.missing-locally > 0: Text {
                                            text: "· " + remote.missing-locally + " not here";
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            color: #e0a94f;
                                        }
                                    }
                                    Text {
                                        text: remote.storage;
                                        font-size: 11px;
                                        color: Palette.foreground.transparentize(35%);
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Button {
                                            text: "Scan";
                                            enabled: !root.busy;
                                            clicked => { root.scan-remote(remote.name); }
                                        }
                                        Button {
                                            text: "Download all";
                                            enabled: !root.busy && remote.missing-locally > 0;
                                            clicked => { root.download-all(remote.name); }
                                        }
                                        Button {
                                            text: "Upload all";
                                            enabled: !root.busy;
                                            clicked => { root.push-all(remote.name); }
                                        }
                                        Button {
                                            text: "Edit";
                                            enabled: !root.busy;
                                            clicked => { root.edit-remote(remote.name); }
                                        }
                                        Button {
                                            text: "Remove";
                                            enabled: !root.busy;
                                            clicked => { root.remove-remote(remote.name); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Settings tab: where metadata backups go ──
                    if root.folder != "" && root.active-tab == 2: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.metadata-summary;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Help { page: "metadata/"; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.folder != "" && root.active-tab == 2 && root.metadata-rows.length == 0: Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: "No remotes configured yet; add one in the Remotes tab.";
                            font-size: 14px;
                            horizontal-alignment: center;
                            color: Palette.foreground.transparentize(40%);
                        }
                    }
                    if root.folder != "" && root.active-tab == 2 && root.metadata-rows.length > 0: ListView {
                        vertical-stretch: 1;
                        for row in root.metadata-rows: VerticalLayout {
                            padding-bottom: 8px;
                            Rectangle {
                                border-width: 1px;
                                border-color: Palette.border;
                                border-radius: 6px;
                                background: Palette.background.darker(0.02);
                                height: metadata-layout.preferred-height;

                                metadata-layout := HorizontalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    CheckBox {
                                        text: row.name;
                                        checked: row.enabled;
                                        enabled: !root.busy;
                                        toggled => { root.toggle-metadata-remote(row.name, self.checked); }
                                    }
                                    Text {
                                        text: row.storage;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: Palette.foreground.transparentize(35%);
                                    }
                                    if row.enabled: Text {
                                        text: row.status;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        color: row.up-to-date ? #2fbf71 : #e0a94f;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Draggable divider between main area and side panel.
            Rectangle {
                width: 7px;
                background: Palette.background;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: divider-touch.has-hover || divider-touch.pressed ? 3px : 1px;
                    background: divider-touch.has-hover || divider-touch.pressed
                        ? Palette.accent-background : Palette.border;
                }

                divider-touch := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        root.sidebar-width = clamp(
                            root.sidebar-width - (self.mouse-x - self.pressed-x),
                            340px,
                            max(340px, root.width - 360px));
                    }
                }
            }

            // ── Side panel ──
            Rectangle {
                width: root.sidebar-width;
                background: Palette.background.darker(0.03);

                side-scroll := ScrollView {
                    mouse-drag-pan-enabled: true;
                    // Wrapped text must measure itself against the panel's
                    // real width, not the unwrapped one.
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        width: side-scroll.visible-width;
                        padding: 14px;
                    // Content keeps its preferred height; when it is shorter
                    // than the panel, the filler below takes the rest.
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 14px;

                        // ════ Blobs tab: the selection ════
                        if root.active-tab == 0 && root.selected-count == 0: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "NOTHING SELECTED"; help: "files/#selecting-files"; }
                        }

                        if root.active-tab == 0 && root.selected-count == 0 && root.folder != "": VerticalLayout {
                            spacing: 8px;
                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle { text: "KEEPING FILES SAFE"; help: "files/#keeping-files-safe"; }
                            Text {
                                text: root.at-risk-count == 0
                                    ? "Every file has at least " + root.min-copies + " cop" + (root.min-copies == 1 ? "y." : "ies.")
                                    : root.at-risk-count + " file(s) have fewer than " + root.min-copies + " copies (shown in red). Upload them to more remotes.";
                                font-size: 12px;
                                wrap: word-wrap;
                                width: Side.text-width;
                                color: root.at-risk-count == 0 ? #2fbf71 : #e05f5f;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Button {
                                    text: "Verify all local copies";
                                    enabled: !root.busy && root.files.length > 0;
                                    clicked => { root.verify-all-local(); }
                                }
                                Button {
                                    text: root.old-local-count > 0
                                        ? "Clean up old versions (" + root.old-local-size + ")" : "Clean up old versions";
                                    enabled: !root.busy && root.old-local-count > 0;
                                    clicked => { root.clean-up-old(); }
                                }
                            }
                        }

                        // ── one file: full details ──
                        if root.active-tab == 0 && root.selected-count == 1 && root.has-detail: VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: root.files[root.detail-index].path;
                                font-size: 15px;
                                font-weight: 700;
                                wrap: word-wrap;
width: Side.text-width;
                            }
                            DetailLine { label: "hash"; value: root.files[root.detail-index].hash; }
                            DetailLine { label: "size"; value: root.files[root.detail-index].size; }
                            DetailLine { label: "added"; value: root.files[root.detail-index].added; }
                            DetailLine {
                                label: "local";
                                value: root.files[root.detail-index].present ? "present" : "missing (download to restore)";
                            }
                            DetailLine {
                                label: "remotes";
                                value: root.files[root.detail-index].remotes == ""
                                    ? "not stored on any remote" : root.files[root.detail-index].remotes;
                            }
                            DetailLine {
                                label: "copies";
                                value: root.files[root.detail-index].copies + " of " + root.min-copies + " wanted"
                                    + (root.files[root.detail-index].at-risk ? " — AT RISK" : "");
                            }
                            if root.files[root.detail-index].other-names != "": DetailLine {
                                label: "also as";
                                value: root.files[root.detail-index].other-names;
                            }
                            if root.files[root.detail-index].past-names != "": DetailLine {
                                label: "was";
                                value: root.files[root.detail-index].past-names;
                            }
                            if root.files[root.detail-index].versions != "": VerticalLayout {
                                spacing: 4px;
                                SectionTitle { text: "PREVIOUS VERSIONS"; }
                                Text {
                                    text: root.files[root.detail-index].versions;
                                    font-size: 11px;
                                    wrap: word-wrap;
width: Side.text-width;
                                    color: Palette.foreground.transparentize(25%);
                                }
                            }
                        }

                        // ── several files: a summary ──
                        if root.active-tab == 0 && root.selected-count > 1: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.selected-count + " files selected";
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.selection-summary;
                                font-size: 12px;
                                wrap: word-wrap;
width: Side.text-width;
                                color: Palette.foreground.transparentize(25%);
                            }
                        }

                        // ── actions on the selection ──
                        if root.active-tab == 0 && root.selected-count > 0: VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle {
                                text: root.selected-count == 1 ? "THIS BLOB" : "THE SELECTED BLOBS";
                                help: "files/#working-with-selected-files";
                            }

                            if root.remote-names.length == 0: Hint {
                                text: "No remotes configured; add one in the Remotes tab.";
                            }
                            if root.remote-names.length > 0: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Remote";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    // Reports a far too tall preferred height in sidebar layouts.
                                    max-height: self.min-height;
                                    model: root.remote-names;
                                    current-index <=> root.action-remote-index;
                                    horizontal-stretch: 1;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Upload";
                                    enabled: !root.busy
                                        && root.remote-names.length > 0
                                        && root.selection-local > 0;
                                    clicked => { root.upload-selected(root.action-remote); }
                                }
                                Button {
                                    text: "Check remote";
                                    enabled: !root.busy && root.remote-names.length > 0;
                                    clicked => { root.check-selected(root.action-remote); }
                                }
                                Button {
                                    text: root.selection-missing > 0
                                        ? "Download (" + root.selection-missing + ")" : "Download";
                                    enabled: !root.busy && root.selection-missing > 0;
                                    clicked => {
                                        root.download-selected(
                                            root.action-remote);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Free up space";
                                    enabled: !root.busy && root.selection-local > 0;
                                    clicked => { root.drop-selected(); }
                                }
                                Button {
                                    text: "Verify";
                                    enabled: !root.busy && root.selection-local > 0;
                                    clicked => { root.verify-selected(); }
                                }
                                Button {
                                    text: "Verify on remote";
                                    enabled: !root.busy && root.remote-names.length > 0;
                                    clicked => { root.verify-selected-on(root.action-remote); }
                                }
                            }
                        }

                        // ════ Settings tab ════
                        if root.active-tab == 2 && root.folder != "" && !root.password-set: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "SET A MASTER PASSWORD"; help: "settings/#the-master-password"; }
                            Hint {
                                text: "Remotes and metadata backups are encrypted with it. Write it down: it can't be recovered.";
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "master password";
                                text <=> root.pw-new;
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "repeat it";
                                text <=> root.pw-repeat;
                                accepted => { root.set-password(root.pw-new, root.pw-repeat); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Set password";
                                    primary: true;
                                    enabled: root.pw-new != "" && root.pw-repeat != "";
                                    clicked => { root.set-password(root.pw-new, root.pw-repeat); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.password-set && !root.unlocked: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "UNLOCK"; help: "settings/#the-master-password"; }
                            Hint { text: "Enter the master password once; it is then saved on this computer."; }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "master password";
                                text <=> root.pw-entry;
                                accepted => { root.unlock(root.pw-entry); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Unlock";
                                    primary: true;
                                    enabled: root.pw-entry != "";
                                    clicked => { root.unlock(root.pw-entry); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.folder-empty: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "RESTORE FROM A BACKUP"; help: "metadata/#restoring-a-lost-folder"; }
                            RestoreForm {
                                remote-names: root.remote-names;
                                busy: root.busy;
                                unlocked: root.unlocked;
                                remote-index <=> root.restore-remote-index;
                                password <=> root.pw-restore;
                                restore(remote, password) => { root.restore-metadata(remote, password); }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.unlocked: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "BACK UP METADATA"; help: "metadata/#backing-up"; }
                            if root.metadata-chosen == 0: Hint {
                                text: "Tick at least one remote on the left to back up to.";
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Back up now";
                                    primary: true;
                                    enabled: !root.busy && root.metadata-chosen > 0;
                                    clicked => { root.backup-metadata(); }
                                }
                            }
                        }

                        if root.active-tab == 2 && root.folder != "" && !root.folder-empty: VerticalLayout {
                            spacing: 6px;
                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle { text: "MERGE IN A BACKUP"; help: "metadata/#merging-in-a-backup"; }
                            RestoreForm {
                                remote-names: root.remote-names;
                                busy: root.busy;
                                unlocked: root.unlocked;
                                remote-index <=> root.restore-remote-index;
                                password <=> root.pw-restore;
                                restore(remote, password) => { root.restore-metadata(remote, password); }
                            }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.unlocked: VerticalLayout {
                            spacing: 6px;
                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle { text: "CHANGE THE MASTER PASSWORD"; help: "settings/#changing-the-password"; }
                            if root.has-encrypted-remotes: Hint {
                                text: "It can't change while remotes are encrypted with it.";
                            }
                            if !root.has-encrypted-remotes: VerticalLayout {
                                spacing: 6px;
                                LineEdit {
                                    input-type: InputType.password;
                                    placeholder-text: "new master password";
                                    text <=> root.pw-new;
                                }
                                LineEdit {
                                    input-type: InputType.password;
                                    placeholder-text: "repeat it";
                                    text <=> root.pw-repeat;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: "Change password";
                                        enabled: !root.busy && root.pw-new != "" && root.pw-repeat != "";
                                        clicked => { root.set-password(root.pw-new, root.pw-repeat); }
                                    }
                                }
                            }
                        }

                        // ════ Remotes tab: edit a remote ════
                        if root.active-tab == 1 && root.editing: VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "EDIT REMOTE “" + root.edit-original + "”"; help: "remotes/#editing-a-remote"; }

                            Text { text: "Name"; font-size: 12px; font-weight: 600; }
                            LineEdit {
                                text <=> root.edit-name;
                                enabled: !root.busy;
                            }
                            Hint { text: "Storage: " + root.edit-description; }
                            if root.edit-note != "": Hint { text: root.edit-note; }

                            if root.edit-fields.length > 0: VerticalLayout {
                                spacing: 8px;
                                SectionTitle { text: "SETTINGS"; }
                                BackendForm {
                                    fields: root.edit-fields;
                                    values <=> root.edit-values;
                                    enabled: !root.busy;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Save";
                                    primary: true;
                                    enabled: !root.busy && root.edit-name != "";
                                    clicked => { root.save-remote-edit(); }
                                }
                                Button {
                                    text: "Cancel";
                                    clicked => { root.cancel-remote-edit(); }
                                }
                            }
                        }

                        // ════ Remotes tab: add a remote ════
                        if root.active-tab == 1 && !root.editing: VerticalLayout {
                            spacing: 14px;

                            // ── guided setup for a new remote ──
                            if !root.unlocked: VerticalLayout {
                                spacing: 6px;
                                SectionTitle { text: "SET UP A NEW REMOTE"; help: "remotes/#setting-up-a-new-remote"; }
                                Hint {
                                    text: root.password-set
                                        ? "Unlock the master password in the Settings tab first: remotes are encrypted with it."
                                        : "Set a master password in the Settings tab first: remotes are encrypted with it.";
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: "Go to Settings";
                                        clicked => { root.active-tab = 2; }
                                    }
                                }
                            }
                            if root.unlocked: VerticalLayout {
                                spacing: 6px;
                                SectionTitle { text: "SET UP A NEW REMOTE"; help: "remotes/#setting-up-a-new-remote"; }

                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "name (e.g. backup)";
                                        text <=> root.new-remote-name;
                                        horizontal-stretch: 1;
                                    }
                                    ComboBox {
                                        // Reports a far too tall preferred height in sidebar layouts.
                                        max-height: self.min-height;
                                        model: root.backend-titles;
                                        current-index: 0;
                                        horizontal-stretch: 2;
                                        enabled: !root.busy && root.setup-state == "";
                                        selected(title) => { root.select-backend(title); }
                                    }
                                }

                                // the generated form
                                if root.setup-active && root.setup-state == "": VerticalLayout {
                                    spacing: 8px;

                                    BackendForm {
                                        fields: root.form-fields;
                                        values <=> root.form-values;
                                        enabled: !root.busy;
                                    }

                                    CheckBox {
                                        text: "Don't encrypt (anyone with access to the remote can read your files)";
                                        checked <=> root.new-remote-plain;
                                        enabled: !root.busy;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            text: "Save Remote";
                                            primary: true;
                                            enabled: root.folder != ""
                                                && !root.busy
                                                && root.new-remote-name != ""
                                                && root.setup-backend != "";
                                            clicked => {
                                                root.submit-form(root.new-remote-name, root.setup-backend, root.form-values, root.new-remote-plain);
                                            }
                                        }
                                        Button {
                                            text: "Cancel";
                                            enabled: !root.busy;
                                            clicked => { root.cancel-remote-setup(); }
                                        }
                                    }
                                }

                                // rclone question fallback (OAuth, verification…)
                                if root.setup-state != "": Rectangle {
                                    border-width: 1px;
                                    border-color: Palette.accent-background;
                                    border-radius: 6px;
                                    background: Palette.background;
                                    height: question-layout.preferred-height + 20px;

                                    question-layout := VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: root.setup-question + (root.setup-default == "" ? "" : " [" + root.setup-default + "]");
                                            font-size: 12px;
                                            font-weight: 600;
                                            wrap: word-wrap;
width: Side.text-width - 20px;
                                        }
                                        Text {
                                            text: root.setup-help;
                                            font-size: 11px;
                                            wrap: word-wrap;
width: Side.text-width - 20px;
                                            color: Palette.foreground.transparentize(25%);
                                        }
                                        if root.setup-url != "": Text {
                                            text: root.setup-url;
                                            font-size: 11px;
                                            wrap: word-wrap;
width: Side.text-width - 20px;
                                            color: Palette.accent-background;
                                        }
                                        LineEdit {
                                            text <=> root.setup-answer;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Button {
                                                text: "Continue";
                                                enabled: root.setup-state != "" && !root.busy;
                                                clicked => {
                                                    root.submit-remote-setup(
                                                        root.setup-backend,
                                                        root.setup-state,
                                                        root.setup-answer == "" ? root.setup-default : root.setup-answer
                                                    );
                                                }
                                            }
                                            Button {
                                                text: "Cancel";
                                                clicked => { root.cancel-remote-setup(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // ══ Status bar ══
        Rectangle {
            height: 30px;
            background: Palette.background.darker(0.06);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                if root.busy: Text {
                    text: "⧗ working…";
                    font-size: 12px;
                    vertical-alignment: center;
                    color: #e0a94f;
                }
                Text {
                    text: root.status-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
