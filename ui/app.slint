import { Button, CheckBox, LineEdit, ListView, Palette, ComboBox, ScrollView, SpinBox } from "std-widgets.slint";

export struct FileRow {
    path: string,
    hash: string,
    short-hash: string,
    size: string,
    added: string,
    present: bool,
    remotes: string,
    other-names: string,
    past-names: string,
    versions: string,
    selected: bool,
    // Copies known (local + remotes), and whether that is below the
    // folder's minimum.
    copies: int,
    at-risk: bool,
}

export struct RemoteRow {
    name: string,
    target: string,
    blobs: string,
    // Blobs recorded on this remote that are not present locally.
    missing-locally: int,
}

// A remote as a metadata backup destination.
export struct MetadataRow {
    name: string,
    target: string,
    // Chosen to receive metadata backups.
    enabled: bool,
    // "up to date · …", "out of date · …", "never backed up".
    status: string,
    up-to-date: bool,
}

// One input of the per-backend setup form.
export struct FormField {
    key: string,
    label: string,
    help: string,
    kind: int,          // 0 = text, 1 = secret, 2 = choice
    default: string,    // placeholder shown while the input is empty
    default-index: int, // preselected example for kind == 2
    examples: [string], // values for kind == 2
    labels: [string],   // how each example is shown
    required: bool,
}

// Wrapped text only reserves the right height when its width is known
// up front, so sidebar text is sized from the panel width explicitly.
global Side {
    in-out property <length> width: 460px;
    // Width available to text inside the panel's padding.
    out property <length> text-width: self.width - 28px;
}

component Hint inherits Text {
    font-size: 11px;
    wrap: word-wrap;
    color: Palette.foreground.transparentize(40%);
    width: Side.text-width;
}

component SectionTitle inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: Palette.foreground.transparentize(35%);
}

component DetailLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Palette.foreground.transparentize(40%);
        width: 60px;
    }
    Text {
        text: root.value;
        font-size: 12px;
        wrap: word-wrap;
        width: Side.text-width - 66px;
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    min-width: label.preferred-width + 24px;
    border-radius: 6px;
    background: root.active ? Palette.accent-background
        : touch.has-hover ? Palette.background.darker(0.08) : transparent;

    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Palette.accent-foreground : Palette.foreground;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The labelled inputs of a backend form, writing answers into `values`.
component BackendForm inherits VerticalLayout {
    in property <[FormField]> fields;
    in-out property <[string]> values;
    in property <bool> enabled: true;
    spacing: 8px;

    for field[i] in root.fields: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: field.required ? field.label + " *" : field.label;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if field.required: Text {
                text: "required";
                font-size: 9px;
                color: #e0a94f;
                vertical-alignment: center;
            }
        }
        if field.help != "": Text {
            text: field.help;
            font-size: 10px;
            wrap: word-wrap;
            width: Side.text-width;
            color: Palette.foreground.transparentize(40%);
        }
        if field.kind == 2: ComboBox {
            // Reports a far too tall preferred height in sidebar layouts.
            max-height: self.min-height;
            model: field.labels;
            current-index: field.default-index;
            enabled: root.enabled;
            selected => { root.values[i] = field.examples[self.current-index]; }
        }
        if field.kind != 2: LineEdit {
            text: root.values[i];
            input-type: field.kind == 1 ? InputType.password : InputType.text;
            enabled: root.enabled;
            placeholder-text: field.default;
            edited(t) => { root.values[i] = t; }
        }
    }
}

export component AppWindow inherits Window {
    title: "My Beloved Rubble";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 480px;

    // ── State ──
    in-out property <string> folder: "";
    in-out property <[FileRow]> files: [];
    in-out property <[RemoteRow]> remotes: [];
    in-out property <[string]> remote-names: [];
    in-out property <string> status-text: "Open a folder to get started";
    in-out property <bool> busy: false;
    // 0 = Blobs, 1 = Remotes, 2 = Metadata backup.
    in-out property <int> active-tab: 0;
    // Copies of every file to keep (local + remotes).
    in-out property <int> min-copies: 2;
    // Files with fewer copies than that.
    in-out property <int> at-risk-count: 0;
    // Local copies of old versions and deleted files, e.g. "3 (1.2 MiB)".
    in-out property <int> old-local-count: 0;
    in-out property <string> old-local-size: "";

    // ── metadata backup ──
    in-out property <[MetadataRow]> metadata-rows: [];
    in-out property <int> metadata-chosen: 0;
    in-out property <string> metadata-summary: "";
    in-out property <bool> password-set: false;
    in-out property <bool> unlocked: false;
    // The folder tracks nothing yet, so a backup can be restored into it.
    in-out property <bool> folder-empty: false;
    in-out property <string> pw-new: "";
    in-out property <string> pw-repeat: "";
    in-out property <string> pw-entry: "";
    in-out property <string> pw-restore: "";
    in-out property <int> restore-remote-index: 0;
    // Side panel width; drag the divider to change it.
    in-out property <length> sidebar-width <=> Side.width;

    // ── blob selection (kept by the Rust side) ──
    in-out property <int> selected-count: 0;
    // The one selected row, when exactly one is selected; else -1.
    in-out property <int> detail-index: -1;
    in-out property <string> selection-summary: "";
    // Distinct selected blobs present / missing locally.
    in-out property <int> selection-local: 0;
    in-out property <int> selection-missing: 0;

    // Name for the guided remote setup.
    in-out property <string> new-remote-name: "";
    // "Add existing target" inputs.
    in-out property <string> existing-remote-name: "";
    in-out property <string> new-remote-target: "";

    // ── guided remote setup ──
    in-out property <[string]> backend-titles: [];
    in-out property <string> setup-backend: "";
    in-out property <bool> setup-active: false;
    in-out property <[FormField]> form-fields: [];
    in-out property <[string]> form-values: [];
    // rclone question fallback (OAuth etc.)
    in-out property <string> setup-state: "";
    in-out property <string> setup-question: "";
    in-out property <string> setup-help: "";
    in-out property <string> setup-answer: "";
    in-out property <string> setup-default: "";
    in-out property <string> setup-url: "";
    in-out property <bool> setup-password: false;

    // ── editing an existing remote ──
    in-out property <bool> editing: false;
    in-out property <string> edit-original: "";
    in-out property <string> edit-name: "";
    in-out property <string> edit-target: "";
    in-out property <string> edit-section: "";
    in-out property <string> edit-note: "";
    in-out property <[FormField]> edit-fields: [];
    in-out property <[string]> edit-values: [];

    // The remote picked for actions on the selected blobs.
    in-out property <int> action-remote-index: 0;
    property <string> action-remote: root.remote-names[clamp(root.action-remote-index, 0, max(0, root.remote-names.length - 1))];

    property <length> row-height: 40px;
    property <bool> has-detail: root.detail-index >= 0 && root.detail-index < root.files.length;

    // ── Callbacks ──
    callback open-folder();
    callback rescan();
    // blob selection: `toggle` is Ctrl/Cmd, `extend` is Shift
    callback row-pressed(index: int, toggle: bool, extend: bool);
    callback row-dragged(index: int);
    callback select-all();
    callback clear-selection();
    // actions on the selected blobs
    callback upload-selected(remote: string);
    callback check-selected(remote: string);
    callback download-selected(remote: string);
    // remote management
    callback scan-remote(name: string);
    callback scan-all-remotes();
    callback download-all(name: string);
    callback push-all(remote: string);
    callback edit-remote(name: string);
    callback save-remote-edit();
    callback cancel-remote-edit();
    callback remove-remote(name: string);
    callback add-remote(name: string, target: string);
    callback select-backend(name: string);
    callback submit-form(name: string, backend: string, values: [string]);
    callback submit-remote-setup(name: string, backend: string, state: string, answer: string);
    callback cancel-remote-setup();
    // keeping copies safe
    callback drop-selected();
    callback verify-selected();
    callback verify-selected-on(remote: string);
    callback verify-all-local();
    callback clean-up-old();
    callback set-min-copies(n: int);
    // metadata backup
    callback toggle-metadata-remote(name: string, enabled: bool);
    callback set-password(password: string, repeat: string);
    callback unlock(password: string);
    callback lock();
    callback backup-metadata();
    callback restore-metadata(remote: string, password: string);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ══ Toolbar ══
        Rectangle {
            height: 52px;
            background: Palette.background.darker(0.06);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;

                Text {
                    text: "My Beloved Rubble";
                    font-weight: 700;
                    font-size: 16px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 8px;
                    TabButton {
                        text: "Blobs (" + root.files.length + ")";
                        active: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }
                    TabButton {
                        text: "Remotes (" + root.remotes.length + ")";
                        active: root.active-tab == 1;
                        clicked => { root.active-tab = 1; }
                    }
                    TabButton {
                        text: "Metadata backup";
                        active: root.active-tab == 2;
                        clicked => { root.active-tab = 2; }
                    }
                }
                Text {
                    text: root.folder;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(40%);
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Open Folder…";
                    clicked => { root.open-folder(); }
                }
                Button {
                    text: "Rescan";
                    enabled: root.folder != "" && !root.busy;
                    clicked => { root.rescan(); }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // ══ Content ══
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 0px;
            spacing: 0px;

            // ── Main area ──
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.background;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    if root.folder == "": Rectangle {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Text {
                                text: "No folder attached";
                                font-size: 18px;
                                horizontal-alignment: center;
                                color: Palette.foreground.transparentize(40%);
                            }
                            Text {
                                text: "Open a folder to attach mbr to it.\nFiles you drop there are content-addressed into .mbr/blobs/ and symlinked back.";
                                font-size: 12px;
                                horizontal-alignment: center;
                                color: Palette.foreground.transparentize(50%);
                            }
                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    text: "Open Folder…";
                                    primary: true;
                                    clicked => { root.open-folder(); }
                                }
                            }
                        }
                    }

                    // ── Blobs tab: the file list ──
                    if root.folder != "" && root.active-tab == 0 && root.files.length == 0: Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: "No tracked files yet.\nDrop files into the folder and hit Rescan.";
                            font-size: 14px;
                            horizontal-alignment: center;
                            color: Palette.foreground.transparentize(40%);
                        }
                    }

                    if root.folder != "" && root.active-tab == 0 && root.files.length > 0: list-keys := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if ((event.modifiers.control || event.modifiers.meta)
                                && (event.text == "a" || event.text == "A")) {
                                root.select-all();
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.clear-selection();
                                return accept;
                            }
                            reject
                        }

                        ListView {
                            for file[idx] in root.files: Rectangle {
                                height: root.row-height;
                                background: file.selected
                                    ? Palette.accent-background
                                    : row-touch.has-hover ? Palette.background.darker(0.04) : transparent;
                                border-radius: 6px;

                                row-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down
                                            && event.button == PointerEventButton.left) {
                                            list-keys.focus();
                                            root.row-pressed(
                                                idx,
                                                event.modifiers.control || event.modifiers.meta,
                                                event.modifiers.shift);
                                        }
                                    }
                                    // Dragging across rows selects them.
                                    moved => {
                                        if (self.pressed) {
                                            root.row-dragged(idx + floor(self.mouse-y / root.row-height));
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    // local presence dot
                                    Text {
                                        text: file.present ? "●" : "○";
                                        color: file.present
                                            ? #2fbf71
                                            : #e05f5f;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        width: 14px;
                                    }
                                    Text {
                                        text: file.path;
                                        font-size: 13px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: file.selected
                                            ? Palette.accent-foreground : Palette.foreground;
                                    }
                                    Text {
                                        text: file.size;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        color: file.selected
                                            ? Palette.accent-foreground.transparentize(20%)
                                            : Palette.foreground.transparentize(35%);
                                    }
                                    Text {
                                        text: file.remotes == "" ? (file.present ? "only here" : "nowhere") : file.remotes;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        width: 140px;
                                        overflow: elide;
                                        color: file.at-risk
                                            ? #e05f5f
                                            : file.selected
                                                ? Palette.accent-foreground.transparentize(20%)
                                                : Palette.foreground.transparentize(35%);
                                    }
                                    Text {
                                        text: file.short-hash;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        color: file.selected
                                            ? Palette.accent-foreground.transparentize(30%)
                                            : Palette.foreground.transparentize(50%);
                                    }
                                }
                            }
                        }
                    }

                    // ── Remotes tab: the remote list ──
                    if root.folder != "" && root.active-tab == 1: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Keep";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        SpinBox {
                            max-height: self.min-height;
                            width: 96px;
                            minimum: 1;
                            maximum: 9;
                            value: root.min-copies;
                            enabled: !root.busy;
                            edited(n) => { root.set-min-copies(n); }
                        }
                        Text {
                            text: "copies of every file (here + remotes); freeing up space needs that many on remotes";
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            color: Palette.foreground.transparentize(25%);
                        }
                    }

                    if root.folder != "" && root.active-tab == 1: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.remotes.length == 0
                                ? "No remotes configured yet; add or set one up on the right."
                                : "Scanning lists a remote fully: every blob found is recorded, and blobs never seen before appear under unnamed/.";
                            font-size: 12px;
                            wrap: word-wrap;
                            // Wrapped text can't report its real height here;
                            // leave room for three lines.
                            min-height: 48px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground.transparentize(40%);
                        }
                        Button {
                            text: "Scan all";
                            enabled: !root.busy && root.remotes.length > 0;
                            clicked => { root.scan-all-remotes(); }
                        }
                    }

                    if root.folder != "" && root.active-tab == 1: ListView {
                        vertical-stretch: 1;
                        for remote in root.remotes: VerticalLayout {
                            padding-bottom: 8px;
                            Rectangle {
                                border-width: 1px;
                                border-color: root.editing && root.edit-original == remote.name
                                    ? Palette.accent-background : Palette.border;
                                border-radius: 6px;
                                background: Palette.background.darker(0.02);
                                height: remote-layout.preferred-height;

                                remote-layout := VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: remote.name;
                                            font-weight: 700;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: remote.blobs;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            color: Palette.foreground.transparentize(40%);
                                        }
                                        if remote.missing-locally > 0: Text {
                                            text: "· " + remote.missing-locally + " not here";
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            color: #e0a94f;
                                        }
                                    }
                                    Text {
                                        text: remote.target;
                                        font-size: 11px;
                                        color: Palette.foreground.transparentize(35%);
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Button {
                                            text: "Scan";
                                            enabled: !root.busy;
                                            clicked => { root.scan-remote(remote.name); }
                                        }
                                        Button {
                                            text: "Download all";
                                            enabled: !root.busy && remote.missing-locally > 0;
                                            clicked => { root.download-all(remote.name); }
                                        }
                                        Button {
                                            text: "Upload all";
                                            enabled: !root.busy;
                                            clicked => { root.push-all(remote.name); }
                                        }
                                        Button {
                                            text: "Edit";
                                            enabled: !root.busy;
                                            clicked => { root.edit-remote(remote.name); }
                                        }
                                        Button {
                                            text: "Remove";
                                            enabled: !root.busy;
                                            clicked => { root.remove-remote(remote.name); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Metadata backup tab: where metadata goes ──
                    if root.folder != "" && root.active-tab == 2: VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.metadata-summary;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: "Tick the remotes that should hold an encrypted copy of this folder's metadata.";
                            font-size: 12px;
                            overflow: elide;
                            color: Palette.foreground.transparentize(40%);
                        }
                    }
                    if root.folder != "" && root.active-tab == 2 && root.metadata-rows.length == 0: Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: "No remotes configured yet; add one in the Remotes tab.";
                            font-size: 14px;
                            horizontal-alignment: center;
                            color: Palette.foreground.transparentize(40%);
                        }
                    }
                    if root.folder != "" && root.active-tab == 2 && root.metadata-rows.length > 0: ListView {
                        vertical-stretch: 1;
                        for row in root.metadata-rows: VerticalLayout {
                            padding-bottom: 8px;
                            Rectangle {
                                border-width: 1px;
                                border-color: Palette.border;
                                border-radius: 6px;
                                background: Palette.background.darker(0.02);
                                height: metadata-layout.preferred-height;

                                metadata-layout := HorizontalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    CheckBox {
                                        text: row.name;
                                        checked: row.enabled;
                                        enabled: !root.busy;
                                        toggled => { root.toggle-metadata-remote(row.name, self.checked); }
                                    }
                                    Text {
                                        text: row.target;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: Palette.foreground.transparentize(35%);
                                    }
                                    if row.enabled: Text {
                                        text: row.status;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        color: row.up-to-date ? #2fbf71 : #e0a94f;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Draggable divider between main area and side panel.
            Rectangle {
                width: 7px;
                background: Palette.background;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: divider-touch.has-hover || divider-touch.pressed ? 3px : 1px;
                    background: divider-touch.has-hover || divider-touch.pressed
                        ? Palette.accent-background : Palette.border;
                }

                divider-touch := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        root.sidebar-width = clamp(
                            root.sidebar-width - (self.mouse-x - self.pressed-x),
                            340px,
                            max(340px, root.width - 360px));
                    }
                }
            }

            // ── Side panel ──
            Rectangle {
                width: root.sidebar-width;
                background: Palette.background.darker(0.03);

                side-scroll := ScrollView {
                    mouse-drag-pan-enabled: true;
                    // Wrapped text must measure itself against the panel's
                    // real width, not the unwrapped one.
                    viewport-width: self.visible-width;
                    VerticalLayout {
                        width: side-scroll.visible-width;
                        padding: 14px;
                    // Content keeps its preferred height; when it is shorter
                    // than the panel, the filler below takes the rest.
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 14px;

                        // ════ Blobs tab: the selection ════
                        if root.active-tab == 0 && root.selected-count == 0: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "NOTHING SELECTED"; }
                            Hint {
                                text: "Click a file to select it. Ctrl+click (⌘+click) adds or removes one, Shift+click selects a range, dragging across rows selects them, Ctrl+A selects everything and Esc clears the selection.\n\nThe selected blobs can then be uploaded to a remote, checked on a remote, downloaded, verified, or removed from this computer once they are safe elsewhere.";
                            }
                        }

                        if root.active-tab == 0 && root.selected-count == 0 && root.folder != "": VerticalLayout {
                            spacing: 8px;
                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle { text: "KEEPING FILES SAFE"; }
                            Text {
                                text: root.at-risk-count == 0
                                    ? "Every file has at least " + root.min-copies + " cop" + (root.min-copies == 1 ? "y." : "ies.")
                                    : root.at-risk-count + " file(s) have fewer than " + root.min-copies + " copies (shown in red). Upload them to more remotes.";
                                font-size: 12px;
                                wrap: word-wrap;
                                width: Side.text-width;
                                color: root.at-risk-count == 0 ? #2fbf71 : #e05f5f;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Button {
                                    text: "Verify all local copies";
                                    enabled: !root.busy && root.files.length > 0;
                                    clicked => { root.verify-all-local(); }
                                }
                                Button {
                                    text: root.old-local-count > 0
                                        ? "Clean up old versions (" + root.old-local-size + ")" : "Clean up old versions";
                                    enabled: !root.busy && root.old-local-count > 0;
                                    clicked => { root.clean-up-old(); }
                                }
                            }
                            Hint {
                                text: "Verifying re-reads every file stored here and checks it still matches its hash; damaged copies are set aside so they can be downloaded again. Cleaning up removes this computer's copies of old versions and deleted files, but only those stored on enough remotes.";
                            }
                        }

                        // ── one file: full details ──
                        if root.active-tab == 0 && root.selected-count == 1 && root.has-detail: VerticalLayout {
                            spacing: 6px;

                            Text {
                                text: root.files[root.detail-index].path;
                                font-size: 15px;
                                font-weight: 700;
                                wrap: word-wrap;
width: Side.text-width;
                            }
                            DetailLine { label: "hash"; value: root.files[root.detail-index].hash; }
                            DetailLine { label: "size"; value: root.files[root.detail-index].size; }
                            DetailLine { label: "added"; value: root.files[root.detail-index].added; }
                            DetailLine {
                                label: "local";
                                value: root.files[root.detail-index].present ? "present" : "missing (download to restore)";
                            }
                            DetailLine {
                                label: "remotes";
                                value: root.files[root.detail-index].remotes == ""
                                    ? "not stored on any remote" : root.files[root.detail-index].remotes;
                            }
                            DetailLine {
                                label: "copies";
                                value: root.files[root.detail-index].copies + " of " + root.min-copies + " wanted"
                                    + (root.files[root.detail-index].at-risk ? " — AT RISK" : "");
                            }
                            if root.files[root.detail-index].other-names != "": DetailLine {
                                label: "also as";
                                value: root.files[root.detail-index].other-names;
                            }
                            if root.files[root.detail-index].past-names != "": DetailLine {
                                label: "was";
                                value: root.files[root.detail-index].past-names;
                            }
                            if root.files[root.detail-index].versions != "": VerticalLayout {
                                spacing: 4px;
                                SectionTitle { text: "PREVIOUS VERSIONS"; }
                                Text {
                                    text: root.files[root.detail-index].versions;
                                    font-size: 11px;
                                    wrap: word-wrap;
width: Side.text-width;
                                    color: Palette.foreground.transparentize(25%);
                                }
                            }
                        }

                        // ── several files: a summary ──
                        if root.active-tab == 0 && root.selected-count > 1: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.selected-count + " files selected";
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.selection-summary;
                                font-size: 12px;
                                wrap: word-wrap;
width: Side.text-width;
                                color: Palette.foreground.transparentize(25%);
                            }
                        }

                        // ── actions on the selection ──
                        if root.active-tab == 0 && root.selected-count > 0: VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle {
                                text: root.selected-count == 1 ? "THIS BLOB" : "THE SELECTED BLOBS";
                            }

                            if root.remote-names.length == 0: Hint {
                                text: "No remotes configured; add one in the Remotes tab.";
                            }
                            if root.remote-names.length > 0: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Remote";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    // Reports a far too tall preferred height in sidebar layouts.
                                    max-height: self.min-height;
                                    model: root.remote-names;
                                    current-index <=> root.action-remote-index;
                                    horizontal-stretch: 1;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Upload";
                                    enabled: !root.busy
                                        && root.remote-names.length > 0
                                        && root.selection-local > 0;
                                    clicked => { root.upload-selected(root.action-remote); }
                                }
                                Button {
                                    text: "Check remote";
                                    enabled: !root.busy && root.remote-names.length > 0;
                                    clicked => { root.check-selected(root.action-remote); }
                                }
                                Button {
                                    text: root.selection-missing > 0
                                        ? "Download (" + root.selection-missing + ")" : "Download";
                                    enabled: !root.busy && root.selection-missing > 0;
                                    clicked => {
                                        root.download-selected(
                                            root.action-remote);
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Free up space";
                                    enabled: !root.busy && root.selection-local > 0;
                                    clicked => { root.drop-selected(); }
                                }
                                Button {
                                    text: "Verify";
                                    enabled: !root.busy && root.selection-local > 0;
                                    clicked => { root.verify-selected(); }
                                }
                                Button {
                                    text: "Verify on remote";
                                    enabled: !root.busy && root.remote-names.length > 0;
                                    clicked => { root.verify-selected-on(root.action-remote); }
                                }
                            }
                            Hint {
                                text: "Upload sends the blobs present here to the remote. Check remote asks the remote whether it holds each blob and updates the records. Download fetches the blobs missing here, trying the chosen remote first, then any other remote recorded as holding them.\n\nFree up space removes the copies on this computer, but only of blobs that at least " + root.min-copies + " remote(s) are confirmed to hold right now; the files stay listed and can be downloaded again. Verify re-reads the local copies and checks their hashes; Verify on remote downloads the remote's copies to check them.";
                            }
                        }

                        // ════ Metadata backup tab ════
                        if root.active-tab == 2 && root.folder != "": VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "WHY BACK UP METADATA"; }
                            Hint {
                                text: "Remotes store files only by their content hash. The names, folders and history of your files live in this folder's database, so it is backed up separately: encrypted with your master password, to the remotes ticked on the left. Without it, a lost folder comes back as a heap of nameless files.";
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.folder-empty: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "RESTORE FROM A BACKUP"; }
                            Hint {
                                text: "This folder tracks no files yet. To bring back a lost folder, set up one of its remotes in the Remotes tab, then restore from it here: every file reappears (as a placeholder until downloaded) and its other remotes come back too.";
                            }
                            if root.remote-names.length == 0: Hint {
                                text: "No remotes configured yet.";
                            }
                            if root.remote-names.length > 0: VerticalLayout {
                                spacing: 6px;
                                ComboBox {
                                    // Reports a far too tall preferred height in sidebar layouts.
                                    max-height: self.min-height;
                                    model: root.remote-names;
                                    current-index <=> root.restore-remote-index;
                                }
                                LineEdit {
                                    input-type: InputType.password;
                                    placeholder-text: "the backup's master password";
                                    text <=> root.pw-restore;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: "Restore";
                                        enabled: !root.busy && root.pw-restore != "";
                                        clicked => {
                                            root.restore-metadata(
                                                root.remote-names[clamp(root.restore-remote-index, 0, root.remote-names.length - 1)],
                                                root.pw-restore);
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                        }

                        if root.active-tab == 2 && root.folder != "" && !root.password-set: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "SET A MASTER PASSWORD"; }
                            Hint {
                                text: "Metadata is encrypted with this password before it leaves this computer. Write it down somewhere safe: without it the backups can't be read, and nobody can recover it.";
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "master password";
                                text <=> root.pw-new;
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "repeat it";
                                text <=> root.pw-repeat;
                                accepted => { root.set-password(root.pw-new, root.pw-repeat); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Set password";
                                    primary: true;
                                    enabled: root.pw-new != "" && root.pw-repeat != "";
                                    clicked => { root.set-password(root.pw-new, root.pw-repeat); }
                                }
                            }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.password-set && !root.unlocked: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "UNLOCK"; }
                            Hint {
                                text: "Enter the master password to back up during this session. It stays in memory until you lock, switch folders or quit.";
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "master password";
                                text <=> root.pw-entry;
                                accepted => { root.unlock(root.pw-entry); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Unlock";
                                    primary: true;
                                    enabled: root.pw-entry != "";
                                    clicked => { root.unlock(root.pw-entry); }
                                }
                            }
                        }

                        if root.active-tab == 2 && root.folder != "" && root.unlocked: VerticalLayout {
                            spacing: 6px;
                            SectionTitle { text: "BACK UP"; }
                            Hint {
                                text: root.metadata-chosen == 0
                                    ? "Tick at least one remote on the left to back up to."
                                    : "Encrypts the database and this folder's rclone settings (so the remotes can be reached again from a new computer) and uploads them to the " + root.metadata-chosen + " ticked remote(s), replacing the previous backup.";
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Button {
                                    text: "Back up now";
                                    primary: true;
                                    enabled: !root.busy && root.metadata-chosen > 0;
                                    clicked => { root.backup-metadata(); }
                                }
                                Button {
                                    text: "Lock";
                                    clicked => { root.lock(); }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border; }
                            SectionTitle { text: "CHANGE THE MASTER PASSWORD"; }
                            Hint {
                                text: "Backups already made keep the old password until they are replaced, so back up again afterwards.";
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "new master password";
                                text <=> root.pw-new;
                            }
                            LineEdit {
                                input-type: InputType.password;
                                placeholder-text: "repeat it";
                                text <=> root.pw-repeat;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Change password";
                                    enabled: !root.busy && root.pw-new != "" && root.pw-repeat != "";
                                    clicked => { root.set-password(root.pw-new, root.pw-repeat); }
                                }
                            }
                        }

                        // ════ Remotes tab: edit a remote ════
                        if root.active-tab == 1 && root.editing: VerticalLayout {
                            spacing: 8px;
                            SectionTitle { text: "EDIT REMOTE “" + root.edit-original + "”"; }

                            Text { text: "Name"; font-size: 12px; font-weight: 600; }
                            LineEdit {
                                text <=> root.edit-name;
                                enabled: !root.busy;
                            }
                            Text { text: "Target"; font-size: 12px; font-weight: 600; }
                            Hint { text: "The rclone location where blobs live, e.g. backup:bucket/mbr. Changing it does not move any blobs; scan the remote afterwards."; }
                            LineEdit {
                                text <=> root.edit-target;
                                enabled: !root.busy;
                            }
                            if root.edit-note != "": Hint { text: root.edit-note; }

                            if root.edit-fields.length > 0: VerticalLayout {
                                spacing: 8px;
                                SectionTitle { text: "RCLONE SETTINGS OF “" + root.edit-section + "”"; }
                                Hint { text: "Secrets are never shown; leave them blank to keep them. Emptied fields keep their current value."; }
                                BackendForm {
                                    fields: root.edit-fields;
                                    values <=> root.edit-values;
                                    enabled: !root.busy;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Save";
                                    primary: true;
                                    enabled: !root.busy && root.edit-name != "" && root.edit-target != "";
                                    clicked => { root.save-remote-edit(); }
                                }
                                Button {
                                    text: "Cancel";
                                    clicked => { root.cancel-remote-edit(); }
                                }
                            }
                        }

                        // ════ Remotes tab: add a remote ════
                        if root.active-tab == 1 && !root.editing: VerticalLayout {
                            spacing: 14px;

                            // ── add an existing target directly ──
                            VerticalLayout {
                                spacing: 4px;
                                SectionTitle { text: "ADD EXISTING TARGET"; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "name (e.g. backup)";
                                        text <=> root.existing-remote-name;
                                        horizontal-stretch: 1;
                                    }
                                    LineEdit {
                                        placeholder-text: "target (s3:bucket/mbr)";
                                        text <=> root.new-remote-target;
                                        horizontal-stretch: 2;
                                    }
                                    Button {
                                        text: "Add";
                                        enabled: root.folder != ""
                                            && root.existing-remote-name != ""
                                            && root.new-remote-target != "";
                                        clicked => {
                                            root.add-remote(root.existing-remote-name, root.new-remote-target);
                                        }
                                    }
                                }
                            }

                            // ── guided setup for a new remote ──
                            VerticalLayout {
                                spacing: 6px;
                                SectionTitle { text: "SET UP A NEW REMOTE"; }

                                HorizontalLayout {
                                    spacing: 6px;
                                    LineEdit {
                                        placeholder-text: "name (e.g. backup)";
                                        text <=> root.new-remote-name;
                                        horizontal-stretch: 1;
                                    }
                                    ComboBox {
                                        // Reports a far too tall preferred height in sidebar layouts.
                                        max-height: self.min-height;
                                        model: root.backend-titles;
                                        current-index: 0;
                                        horizontal-stretch: 2;
                                        enabled: !root.busy && root.setup-state == "";
                                        selected(title) => { root.select-backend(title); }
                                    }
                                }

                                // the generated form
                                if root.setup-active && root.setup-state == "": VerticalLayout {
                                    spacing: 8px;

                                    BackendForm {
                                        fields: root.form-fields;
                                        values <=> root.form-values;
                                        enabled: !root.busy;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            text: "Save Remote";
                                            primary: true;
                                            enabled: root.folder != ""
                                                && !root.busy
                                                && root.new-remote-name != ""
                                                && root.setup-backend != "";
                                            clicked => {
                                                root.submit-form(root.new-remote-name, root.setup-backend, root.form-values);
                                            }
                                        }
                                        Button {
                                            text: "Cancel";
                                            enabled: !root.busy;
                                            clicked => { root.cancel-remote-setup(); }
                                        }
                                    }
                                }

                                // rclone question fallback (OAuth, verification…)
                                if root.setup-state != "": Rectangle {
                                    border-width: 1px;
                                    border-color: Palette.accent-background;
                                    border-radius: 6px;
                                    background: Palette.background;
                                    height: question-layout.preferred-height + 20px;

                                    question-layout := VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: root.setup-question + (root.setup-default == "" ? "" : " [" + root.setup-default + "]");
                                            font-size: 12px;
                                            font-weight: 600;
                                            wrap: word-wrap;
width: Side.text-width - 20px;
                                        }
                                        Text {
                                            text: root.setup-help;
                                            font-size: 11px;
                                            wrap: word-wrap;
width: Side.text-width - 20px;
                                            color: Palette.foreground.transparentize(25%);
                                        }
                                        if root.setup-url != "": Text {
                                            text: root.setup-url;
                                            font-size: 11px;
                                            wrap: word-wrap;
width: Side.text-width - 20px;
                                            color: Palette.accent-background;
                                        }
                                        LineEdit {
                                            text <=> root.setup-answer;
                                            input-type: root.setup-password ? InputType.password : InputType.text;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Button {
                                                text: "Continue";
                                                enabled: root.setup-state != "" && !root.busy;
                                                clicked => {
                                                    root.submit-remote-setup(
                                                        root.new-remote-name,
                                                        root.setup-backend,
                                                        root.setup-state,
                                                        root.setup-answer == "" ? root.setup-default : root.setup-answer
                                                    );
                                                }
                                            }
                                            Button {
                                                text: "Cancel";
                                                clicked => { root.cancel-remote-setup(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.border; }

        // ══ Status bar ══
        Rectangle {
            height: 30px;
            background: Palette.background.darker(0.06);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                if root.busy: Text {
                    text: "⧗ working…";
                    font-size: 12px;
                    vertical-alignment: center;
                    color: #e0a94f;
                }
                Text {
                    text: root.status-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
